    },
    "A saved start point jumps you straight to the useful part.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto de inicio guardado te lleva directo a la parte útil."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ponto de início salvo te leva direto à parte útil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gespeicherter Startpunkt bringt dich direkt zum nützlichen Teil."
          }
        }
      }
    },
    "A starting point, not a prescription. Not medical advice.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto de partida, no una prescripción. No es consejo médico."
