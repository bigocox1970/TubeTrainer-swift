    "Add the YouTube trainers you already trust — or skip this and discover videos exercise by exercise.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade los entrenadores de YouTube en los que ya confías, o sáltalo y descubre vídeos ejercicio a ejercicio."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione os treinadores do YouTube em quem você já confia — ou pule e descubra vídeos exercício por exercício."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die YouTube-Trainer hinzu, denen du schon vertraust — oder überspringe das und entdecke Videos Übung für Übung."
          }
        }
      }
    },
    "Add the movements you want in this workout.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade los movimientos que quieras en este entrenamiento."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione os movimentos que você quer neste treino."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die Übungen hinzu, die du in diesem Training haben möchtest."
          }
        }
      }
    },
    "Add the name of a YouTube trainer you trust. When you find coaching, theirs gets prioritised.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el nombre de un entrenador de YouTube en el que confíes. Cuando encuentres vídeos, los suyos tendrán prioridad."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o nome de um treinador do YouTube em quem você confia. Quando você encontrar vídeos, os dele terão prioridade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen YouTube-Trainer hinzu, dem du vertraust. Seine Videos werden bei der Suche bevorzugt."
          }
        }
      }
    },
