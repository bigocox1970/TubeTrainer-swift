    },
    "Aliases make search forgiving — type any of them to find this exercise.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los alias hacen la búsqueda más flexible: escribe cualquiera de ellos para encontrar este ejercicio."
