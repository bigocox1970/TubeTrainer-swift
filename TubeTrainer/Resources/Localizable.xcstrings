    },
    "Add the name of a YouTube trainer you trust. When you find coaching, theirs gets prioritised.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el nombre de un entrenador de YouTube en el que confíes. Cuando encuentres vídeos, los suyos tendrán prioridad."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o nome de um treinador do YouTube em quem você confia. Quando você encontrar vídeos, os dele terão prioridade."
