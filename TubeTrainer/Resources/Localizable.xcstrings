    "Add favourite YouTube coaches so their videos get prioritised — or skip and discover as you go.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade entrenadores favoritos de YouTube para que sus vídeos tengan prioridad, o sáltalo y descúbrelos sobre la marcha."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione treinadores favoritos do YouTube para que os vídeos deles tenham prioridade — ou pule e descubra ao longo do caminho."
          }
        }
      }
    },
    "Add set": {
      "localizations": {
        "es": {
