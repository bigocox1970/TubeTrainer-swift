    "Add, remove or reorder. Seeded with sensible basics.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade, quita o reordena. Ya incluye lo básico."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione, remova ou reordene. Já vem com o básico."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen, entfernen oder umsortieren. Mit sinnvollen Basics vorbelegt."
          }
        }
      }
    },
    "Aliases make search forgiving — type any of them to find this exercise.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los alias hacen la búsqueda más flexible: escribe cualquiera de ellos para encontrar este ejercicio."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apelidos deixam a busca flexível — digite qualquer um deles para encontrar este exercício."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aliasse machen die Suche flexibel — tippe einen davon ein, um diese Übung zu finden."
          }
        }
      }
    },
