---
// Official-style "Download on the App Store" badge (Apple wordmark + logo).
// href defaults to the TestFlight/App Store link passed in.
const { href = '#', label = 'App Store', sub = 'Download on the', large = false } = Astro.props;
---
<a class:list={['asb', { 'asb-lg': large }]} href={href} target="_blank" rel="noopener" aria-label={`${sub} ${label}`}>
  <svg class="asb-apple" viewBox="0 0 384 512" aria-hidden="true">
    <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5c0 26.2 4.8 53.3 14.4 81.2 12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/>
  </svg>
  <span class="asb-text">
    <small>{sub}</small>
    <strong>{label}</strong>
  </span>
</a>

<style>
  .asb {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 22px;
    border-radius: 14px;
    background: #000;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.28);
    box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.7);
    transition: transform 0.15s ease, background 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;
  }
  html[data-theme='light'] .asb {
    border-color: rgba(0, 0, 0, 0.14);
    box-shadow: 0 10px 26px -14px rgba(0, 0, 0, 0.45);
  }
  .asb:hover { background: #141416; transform: translateY(-1px); }
  .asb:active { transform: scale(0.98); }
  .asb-apple { width: 26px; height: 30px; fill: #fff; flex: 0 0 auto; margin-top: -2px; }
  .asb-text { display: flex; flex-direction: column; line-height: 1.05; text-align: left; }
  .asb-text small {
    font-size: 12px; font-weight: 500; letter-spacing: 0.01em; opacity: 0.9;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  .asb-text strong {
    font-size: 21px; font-weight: 600; letter-spacing: -0.01em; margin-top: 3px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  .asb-lg { padding: 15px 28px; }
  .asb-lg .asb-apple { width: 30px; height: 34px; }
  .asb-lg .asb-text strong { font-size: 24px; }
</style>
